# SAM3 Annotation Tool - Environment Configuration

# GPU Configuration
SAM3_GPU_INDEX=0

# For local development from backend/ working directory (WSL):
SAM3_CHECKPOINT_PATH=app/sam3/sam3.pt

# Explicit BPE vocab path to avoid pkg_resources issues in namespace-package setups
SAM3_BPE_PATH=sam3/sam3/assets/bpe_simple_vocab_16e6.txt.gz

# For local development, ensure the model directory is correctly set to where sam3.pt is located
SAM3_MODEL_DIR=/app/sam3

# Set to "1" to load the model at startup, or "0" to load on demand
SAM3_EAGER_LOAD="0"
